# 复制本文件为 .env 并填入你自己的值（.env 已被 .gitignore 忽略，不会进仓库）
#
# 生成随机密钥（二选一）：
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   openssl rand -base64 32
#
# ⚠️ 务必固定该值：它是会话文件的加密密钥，变了会导致已保存的会话解密失败，
#    用户需要重新登录。部署后不要随意改。
FERNET_KEY=__CHANGE_ME_TO_A_RANDOM_KEY__

# 调试接口开关（/api/debug/*）：默认关闭。排查字段解析问题时在运行环境设 1，
# 生产环境不要打开——这些接口会透出上游 API 的原始结构。
#WT_DEBUG=1

# 任务描述缓存 TTL（秒），默认 300；设 0 关闭（每次都真实请求详情接口）
#WT_DESC_CACHE_TTL=300

# 全量任务列表缓存 TTL（秒）：搜索 / typeahead / 导出 / 延期扫描共用，
# 默认 120；设 0 关闭。延期视图点「刷新」会强制绕过重新扫描
#WT_TASKS_CACHE_TTL=120
